<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LT TECNO - Iniciar Sesión</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body class="login-body">
    <div class="login-container">
        <div class="login-card">
            <h1 class="logo-title">LT TECNO</h1>
            <h2>Panel de Administración</h2>
            
            <form id="loginForm" onsubmit="handleLogin(event)">
                <div class="form-group">
                    <label for="email">Correo Electrónico</label>
                    <input type="email" id="email" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <input type="password" id="password" required>
                </div>
                
                <div id="errorMessage" class="error-message"></div>
                
                <button type="submit" class="btn-primary btn-full">Ingresar</button>
                <button type="button" onclick="window.location.href='index.html'" class="btn-secondary btn-full">
                    Volver
                </button>
            </form>
        </div>
    </div>
    
    <script>
        function handleLogin(event) {
            event.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const errorDiv = document.getElementById('errorMessage');
            
            if (email === 'truenolauti@gmail.com' && password === '05012003Lau') {
                localStorage.setItem('isLoggedIn', 'true');
                window.location.href = 'admin.html';
            } else {
                errorDiv.textContent = 'Correo electrónico o contraseña incorrectos';
                errorDiv.style.display = 'block';
            }
        }
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LT TECNO - Panel de Administración</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body class="admin-body">
    <div class="admin-container">
        <header class="admin-header">
            <h1>LT TECNO - Panel de Administración</h1>
            <button onclick="logout()" class="btn-logout">Cerrar Sesión</button>
        </header>
        
        <nav class="admin-nav">
            <button class="nav-btn active" onclick="showSection('dashboard')">Dashboard</button>
            <button class="nav-btn" onclick="showSection('inventory')">Inventario</button>
            <button class="nav-btn" onclick="showSection('clients')">Clientes</button>
            <button class="nav-btn" onclick="showSection('sales')">Ventas</button>
            <button class="nav-btn" onclick="showSection('balance')">Balance</button>
        </nav>
        
        <main class="admin-main">
            <!-- DASHBOARD -->
            <section id="dashboard" class="admin-section active">
                <h2>Resumen General</h2>
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>Productos en Stock</h3>
                        <p class="stat-value" id="totalProducts">0</p>
                    </div>
                    <div class="stat-card">
                        <h3>Total Clientes</h3>
                        <p class="stat-value" id="totalClients">0</p>
                    </div>
                    <div class="stat-card">
                        <h3>Ventas del Mes</h3>
                        <p class="stat-value" id="salesMonth">$0</p>
                    </div>
                    <div class="stat-card">
                        <h3>Ganancias del Mes</h3>
                        <p class="stat-value" id="profitMonth">$0</p>
                    </div>
                </div>
            </section>
            
            <!-- INVENTARIO -->
            <section id="inventory" class="admin-section">
                <div class="section-header">
                    <h2>Inventario</h2>
                    <button class="btn-primary" onclick="showAddProductModal()">+ Agregar Producto</button>
                </div>
                
                <div class="section-controls">
                    <button class="btn-secondary" onclick="showAddCategoryModal()">+ Nueva Sección</button>
                    <select id="filterCategory" onchange="filterInventory()">
                        <option value="">Todas las Secciones</option>
                    </select>
                </div>
                
                <div class="table-container">
                    <table id="inventoryTable">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Sección</th>
                                <th>Stock</th>
                                <th>Costo</th>
                                <th>1-10 unid.</th>
                                <th>11-50 unid.</th>
                                <th>51-100 unid.</th>
                                <th>101-200 unid.</th>
                                <th>+500 unid.</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="inventoryBody">
                        </tbody>
                    </table>
                </div>
            </section>
            
            <!-- CLIENTES -->
            <section id="clients" class="admin-section">
                <div class="section-header">
                    <h2>Clientes</h2>
                    <button class="btn-primary" onclick="showAddClientModal()">+ Agregar Cliente</button>
                </div>
                
                <div class="table-container">
                    <table id="clientsTable">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Celular</th>
                                <th>Deuda Total</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="clientsBody">
                        </tbody>
                    </table>
                </div>
            </section>
            
            <!-- VENTAS -->
            <section id="sales" class="admin-section">
                <h2>Historial de Ventas</h2>
                
                <div class="section-controls">
                    <select id="salesFilter" onchange="filterSales()">
                        <option value="all">Todas</option>
                        <option value="paid">Pagadas</option>
                        <option value="pending">Pendientes</option>
                    </select>
                </div>
                
                <div class="table-container">
                    <table id="salesTable">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Método de Pago</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="salesBody">
                        </tbody>
                    </table>
                </div>
            </section>
            
            <!-- BALANCE -->
            <section id="balance" class="admin-section">
                <h2>Balance Financiero</h2>
                
                <div class="balance-controls">
                    <button class="btn-filter" onclick="updateBalance('day')">Día</button>
                    <button class="btn-filter" onclick="updateBalance('week')">Semana</button>
                    <button class="btn-filter active" onclick="updateBalance('month')">Mes</button>
                    <button class="btn-filter" onclick="updateBalance('year')">Año</button>
                </div>
                
                <div class="balance-grid">
                    <div class="balance-card gain">
                        <h3>Total Vendido</h3>
                        <p class="balance-value" id="balanceSold">$0</p>
                    </div>
                    <div class="balance-card expense">
                        <h3>Gastos (Costos)</h3>
                        <p class="balance-value" id="balanceExpenses">$0</p>
                    </div>
                    <div class="balance-card profit">
                        <h3>Ganancias Netas</h3>
                        <p class="balance-value" id="balanceProfit">$0</p>
                    </div>
                </div>
                
                <div class="balance-details">
                    <h3>Detalles del Período</h3>
                    <p>Total de Ventas: <span id="balanceTotalSales">0</span></p>
                    <p>Productos Vendidos: <span id="balanceProductsSold">0</span></p>
                </div>
            </section>
        </main>
    </div>
    
    <!-- MODALES -->
    <!-- Modal Agregar Producto -->
    <div id="addProductModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('addProductModal')">&times;</span>
            <h2>Agregar Producto</h2>
            <form id="addProductForm" onsubmit="handleAddProduct(event)">
                <div class="form-group">
                    <label>Nombre del Producto</label>
                    <input type="text" id="productName" required>
                </div>
                <div class="form-group">
                    <label>Sección</label>
                    <select id="productCategory" required>
                        <option value="">Seleccionar sección</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Stock Inicial</label>
                    <input type="number" id="productStock" min="0" required>
                </div>
                <div class="form-group">
                    <label>Costo del Producto</label>
                    <input type="number" id="productCost" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 1-10 unidades</label>
                    <input type="number" id="productPrice1" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 11-50 unidades</label>
                    <input type="number" id="productPrice2" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 51-100 unidades</label>
                    <input type="number" id="productPrice3" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 101-200 unidades</label>
                    <input type="number" id="productPrice4" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio +500 unidades</label>
                    <input type="number" id="productPrice5" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>URL de Imagen (opcional)</label>
                    <input type="url" id="productImage">
                </div>
                <div class="form-group">
                    <label>Descripción (opcional)</label>
                    <textarea id="productDescription" rows="3"></textarea>
                </div>
                <button type="submit" class="btn-primary">Guardar Producto</button>
            </form>
        </div>
    </div>
    
    <!-- Modal Editar Producto -->
    <div id="editProductModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('editProductModal')">&times;</span>
            <h2>Editar Producto</h2>
            <form id="editProductForm" onsubmit="handleEditProduct(event)">
                <input type="hidden" id="editProductId">
                <div class="form-group">
                    <label>Nombre del Producto</label>
                    <input type="text" id="editProductName" required>
                </div>
                <div class="form-group">
                    <label>Sección</label>
                    <select id="editProductCategory" required>
                        <option value="">Seleccionar sección</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Stock</label>
                    <input type="number" id="editProductStock" min="0" required>
                </div>
                <div class="form-group">
                    <label>Costo del Producto</label>
                    <input type="number" id="editProductCost" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 1-10 unidades</label>
                    <input type="number" id="editProductPrice1" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 11-50 unidades</label>
                    <input type="number" id="editProductPrice2" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 51-100 unidades</label>
                    <input type="number" id="editProductPrice3" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio 101-200 unidades</label>
                    <input type="number" id="editProductPrice4" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>Precio +500 unidades</label>
                    <input type="number" id="editProductPrice5" min="0" step="0.01" required>
                </div>
                <div class="form-group">
                    <label>URL de Imagen (opcional)</label>
                    <input type="url" id="editProductImage">
                </div>
                <div class="form-group">
                    <label>Descripción (opcional)</label>
                    <textarea id="editProductDescription" rows="3"></textarea>
                </div>
                <button type="submit" class="btn-primary">Guardar Cambios</button>
            </form>
        </div>
    </div>
    
    <!-- Modal Agregar Categoría -->
    <div id="addCategoryModal" class="modal">
        <div class="modal-content modal-small">
            <span class="close" onclick="closeModal('addCategoryModal')">&times;</span>
            <h2>Agregar Sección</h2>
            <form id="addCategoryForm" onsubmit="handleAddCategory(event)">
                <div class="form-group">
                    <label>Nombre de la Sección</label>
                    <input type="text" id="categoryName" required>
                </div>
                <button type="submit" class="btn-primary">Guardar Sección</button>
            </form>
        </div>
    </div>
    
    <!-- Modal Agregar Cliente -->
    <div id="addClientModal" class="modal">
        <div class="modal-content modal-small">
            <span class="close" onclick="closeModal('addClientModal')">&times;</span>
            <h2>Agregar Cliente</h2>
            <form id="addClientForm" onsubmit="handleAddClient(event)">
                <div class="form-group">
                    <label>Nombre Completo</label>
                    <input type="text" id="clientName" required>
                </div>
                <div class="form-group">
                    <label>Número de Celular</label>
                    <input type="tel" id="clientPhone" required>
                </div>
                <button type="submit" class="btn-primary">Guardar Cliente</button>
            </form>
        </div>
    </div>
    
    <!-- Modal Detalles de Cliente -->
    <div id="clientDetailsModal" class="modal">
        <div class="modal-content modal-large">
            <span class="close" onclick="closeModal('clientDetailsModal')">&times;</span>
            <h2 id="clientDetailsName">Detalles del Cliente</h2>
            <div id="clientDetailsContent"></div>
        </div>
    </div>
    
    <!-- Modal Detalles de Venta -->
    <div id="saleDetailsModal" class="modal">
        <div class="modal-content modal-large">
            <span class="close" onclick="closeModal('saleDetailsModal')">&times;</span>
            <h2>Detalles de Venta</h2>
            <div id="saleDetailsContent"></div>
        </div>
    </div>
    
    <script src="admin.js"></script>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LT TECNO - Tienda</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body class="shop-body">
    <!-- Header -->
    <header class="shop-header">
        <div class="header-content">
            <button class="menu-toggle" onclick="toggleSidebar()">☰</button>
            <h1 class="shop-logo">LT TECNO</h1>
            <div class="header-actions">
                <div class="search-container">
                    <input type="text" id="searchInput" placeholder="Buscar productos..." onkeyup="searchProducts()">
                    <button onclick="searchProducts()">🔍</button>
                </div>
                <button class="cart-btn" onclick="toggleCart()">
                    🛒 <span id="cartCount">0</span>
                </button>
            </div>
        </div>
    </header>
    
    <!-- Sidebar -->
    <aside id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <h3>Secciones</h3>
            <button class="close-sidebar" onclick="toggleSidebar()">✕</button>
        </div>
        <nav id="sidebarNav" class="sidebar-nav">
            <button class="sidebar-item active" onclick="filterByCategory('')">Todos los Productos</button>
        </nav>
    </aside>
    
    <!-- Main Content -->
    <main class="shop-main">
        <!-- Featured Products Carousel -->
        <section class="carousel-section">
            <h2>Productos Destacados</h2>
            <div class="carousel">
                <button class="carousel-btn prev" onclick="moveCarousel(-1)">❮</button>
                <div class="carousel-container" id="carouselContainer">
                </div>
                <button class="carousel-btn next" onclick="moveCarousel(1)">❯</button>
            </div>
        </section>
        
        <!-- Current Category -->
        <section class="products-section">
            <h2 id="currentCategoryTitle">Todos los Productos</h2>
            <div class="products-grid" id="productsGrid">
            </div>
        </section>
    </main>
    
    <!-- Shopping Cart -->
    <div id="cartSidebar" class="cart-sidebar">
        <div class="cart-header">
            <h2>Carrito de Compras</h2>
            <button class="close-cart" onclick="toggleCart()">✕</button>
        </div>
        <div class="cart-items" id="cartItems">
        </div>
        <div class="cart-summary">
            <div class="cart-total">
                <span>Total:</span>
                <span id="cartTotal">$0</span>
            </div>
            <button class="btn-primary btn-full" onclick="showCheckout()">Proceder al Pago</button>
            <button class="btn-secondary btn-full" onclick="clearCart()">Vaciar Carrito</button>
        </div>
    </div>
    
    <!-- Checkout Modal -->
    <div id="checkoutModal" class="modal">
        <div class="modal-content modal-large">
            <span class="close" onclick="closeModal('checkoutModal')">&times;</span>
            <h2>Finalizar Compra</h2>
            
            <div class="checkout-summary">
                <h3>Resumen del Pedido</h3>
                <div id="checkoutItems"></div>
                <div class="checkout-total">
                    <strong>Subtotal:</strong> <span id="checkoutSubtotal">$0</span>
                </div>
                <div class="checkout-total" id="mpSurchargeDiv" style="display:none;">
                    <strong>Recargo Mercado Pago (6%):</strong> <span id="mpSurcharge">$0</span>
                </div>
                <div class="checkout-total checkout-final">
                    <strong>Total:</strong> <span id="checkoutTotal">$0</span>
                </div>
            </div>
            
            <form id="checkoutForm" onsubmit="handleCheckout(event)">
                <h3>Tipo de Entrega</h3>
                <div class="form-group">
                    <select id="deliveryType" required onchange="updateDeliveryFields()">
                        <option value="">Seleccione una opción</option>
                        <option value="local">Envío Local (Rosario)</option>
                        <option value="national">Envío Nacional</option>
                        <option value="pickup">Retiro en Sucursal</option>
                    </select>
                </div>
                
                <div id="deliveryFields"></div>
                
                <h3>Método de Pago</h3>
                <div class="form-group">
                    <select id="paymentMethod" required onchange="updatePaymentMethod()">
                        <option value="">Seleccione un método</option>
                        <option value="transfer">Transferencia</option>
                        <option value="mercadopago">Mercado Pago (+6%)</option>
                        <option value="cash" id="cashOption" disabled>Efectivo (Solo retiro en sucursal)</option>
                    </select>
                </div>
                
                <div id="paymentInfo"></div>
                
                <button type="submit" class="btn-primary btn-full">Confirmar Pedido</button>
            </form>
        </div>
    </div>
    
    <!-- Receipt Modal -->
    <div id="receiptModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal('receiptModal')">&times;</span>
            <div id="receiptContent" class="receipt"></div>
            <button class="btn-primary btn-full" onclick="printReceipt()">Imprimir Comprobante</button>
            <button class="btn-secondary btn-full" onclick="finishPurchase()">Finalizar</button>
        </div>
    </div>
    
    <script src="shop.js"></script>
</body>
</html>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --gold: #D4AF37;
    --dark-gold: #B8941E;
    --black: #1a1a1a;
    --light-black: #2d2d2d;
    --white: #ffffff;
    --light-gray: #f5f5f5;
    --gray: #cccccc;
    --dark-gray: #666666;
    --success: #4CAF50;
    --danger: #f44336;
    --warning: #ff9800;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    line-height: 1.6;
    color: var(--black);
}

/* ========== INDEX PAGE ========== */
.index-body {
    background: linear-gradient(135deg, var(--black) 0%, var(--light-black) 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.index-container {
    text-align: center;
    padding: 2rem;
}

.logo-section {
    margin-bottom: 3rem;
}

.logo-title {
    font-size: 4rem;
    color: var(--gold);
    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    margin-bottom: 0.5rem;
}

.logo-subtitle {
    font-size: 1.2rem;
    color: var(--white);
    opacity: 0.8;
}

.selection-buttons {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
}

.selection-card {
    background: var(--white);
    padding: 2.5rem;
    border-radius: 10px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.3);
    width: 300px;
    transition: transform 0.3s ease;
}

.selection-card:hover {
    transform: translateY(-5px);
}

.selection-card h2 {
    color: var(--black);
    margin-bottom: 1rem;
}

.selection-card p {
    color: var(--dark-gray);
    margin-bottom: 1.5rem;
}

/* ========== BUTTONS ========== */
.btn-primary, .btn-secondary, .btn-logout, .btn-filter {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    font-weight: 600;
}

.btn-primary {
    background: var(--gold);
    color: var(--black);
}

.btn-primary:hover {
    background: var(--dark-gold);
    transform: scale(1.05);
}

.btn-secondary {
    background: var(--light-black);
    color: var(--white);
}

.btn-secondary:hover {
    background: var(--black);
}

.btn-full {
    width: 100%;
    margin-top: 0.5rem;
}

.btn-logout {
    background: var(--danger);
    color: var(--white);
}

.btn-filter {
    background: var(--light-gray);
    color: var(--black);
    margin: 0.25rem;
}

.btn-filter.active {
    background: var(--gold);
}

/* ========== LOGIN PAGE ========== */
.login-body {
    background: linear-gradient(135deg, var(--black) 0%, var(--light-black) 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

.login-container {
    width: 100%;
    max-width: 400px;
    padding: 1rem;
}

.login-card {
    background: var(--white);
    padding: 2.5rem;
    border-radius: 10px;
    box-shadow: 0 8px 16px rgba(0,0,0,0.3);
}

.login-card h1 {
    color: var(--gold);
    text-align: center;
    margin-bottom: 0.5rem;
}

.login-card h2 {
    color: var(--black);
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.2rem;
